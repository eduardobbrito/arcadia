{
  "manifest_version": 3,
  "name": "Arcadia for Dia: spaces and mini windows",
  "short_name": "Arcadia",
  "version": "0.1.0",
  "description": "What Dia lacks from Arc: spaces inside a profile, mini windows, cleaned link copying and Clear. Uses Dia's own sidebar. Private: no network, no tracking.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting",
    "history",
    "bookmarks",
    "favicon",
    "search",
    "contextMenus",
    "offscreen",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Arcadia spaces",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bar/bar.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the spaces menu"
    },
    "command-bar": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open the Arcadia palette"
    },
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current page link"
    },
    "mini-window": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open a mini window"
    },
    "copy-url-markdown": {
      "description": "Copy the current page link as Markdown"
    },
    "next-space": {
      "description": "Go to the next space"
    },
    "previous-space": {
      "description": "Go to the previous space"
    },
    "pop-out": {
      "description": "Open the current tab in a mini window"
    },
    "clear-tabs": {
      "description": "Clear unused tabs in this space"
    }
  }
}
